# Database Configuration
DATABASE_URL=postgresql://nyaya_user:nyaya_password@localhost:5432/nyaya_ai
POSTGRES_USER=nyaya_user
POSTGRES_PASSWORD=nyaya_password
POSTGRES_DB=nyaya_ai

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333

# AWS S3 Configuration (Public Bucket - No Credentials Needed)
S3_BUCKET_NAME=indian-high-court-judgments
S3_REGION=ap-south-1

# LLM API Keys (Add your keys here)
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
GOOGLE_API_KEY=your_google_key_here

# LLM Model Configuration
EXTRACTION_MODEL=gpt-4o-mini
EXTRACTION_TEMPERATURE=0.1
MAX_RETRIES=3
RETRY_DELAY=2

# Processing Configuration
BATCH_SIZE=10
MAX_CONCURRENT_REQUESTS=5
DOWNLOAD_MAX_CASES=100

# Court Codes to Download (comma-separated)
TARGET_COURTS=DL_HC,BH_HC
TARGET_YEARS=2024,2023

# Logging
LOG_LEVEL=INFO
LOG_FILE=data/logs/pipeline.log

# Similar Case Retrieval
DEFAULT_TOP_K=10
VECTOR_SEARCH_CANDIDATES=50
SIMILARITY_THRESHOLD=0.5
ENABLE_RERANKING=true
ENABLE_LLM_EXPLANATION=true
ENABLE_QUERY_LLM_METADATA=false
RERANKER_VECTOR_WEIGHT=0.3
RERANKER_MODEL_WEIGHT=0.7

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
